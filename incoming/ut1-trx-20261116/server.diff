+      liveCheck: async () => { net.live++; return LIVE_NO_USDT; },
+    },
+    fees: { transferFee: async () => ({ energyFeeSun: 0, netFeeSun: 0, netUsage: 270, energyUsage: 0 }) },
+    store, now: () => ++clock.t, newId: () => `p${++id}`, billing, log: (l: string) => logs.push(l), alert: () => {},
+    energyUsedOf: async () => 0,
+    bandwidthLeftOf: async () => net.bwLeft,
+  } as never);
+  const charge = (opts: Record<string, unknown> = {}) => pult.charge(A, B, { pollMs: 1, accountId: ACC, waitMs: 50, legs: "bandwidth", asset: "trx", ...opts } as never);
+  const bal = async () => (await billing.accountBalance(ACC)).availableSun;
+  const book = (cid: string) => billing.log.filter((l) => l.ref === cid).map((l) => l.kind);
+  return { clock, net, billing, pult, store, logs, orders, charge, bal, book };
+}
