+test("перевод TRX: одна нога из Банка, удержано 0,32, ready без живой проверки USDT, ответ повторяет transfer", async () => {
+  const s = await setup();
+  const r = await s.charge();
+  assert.ok(r.ok && !r.nothingToCharge, json(r));
+  if (!r.ok || r.nothingToCharge) return;
+  assert.deepEqual(s.net.needsAsset, ["trx"], "потребность читается как у перевода TRX");
+  assert.deepEqual(s.orders, ["bandwidth:own_bw:351"]);
+  const c = (await s.store.get(r.charge.id))!;
+  assert.deepEqual([c.state.only, c.state.asset, c.state.status, r.view.ready], ["bandwidth", "trx", "ready", true]);
+  assert.equal(s.net.live, 0, "живая проверка USDT не звалась");
+  assert.equal(await s.bal(), trx(10) - PRICE);
+  const out = clientCharge(r) as Record<string, unknown>;
+  assert.deepEqual([out["ok"], out["legs"], out["transfer"]], [true, "bandwidth", "trx"]);
+});
