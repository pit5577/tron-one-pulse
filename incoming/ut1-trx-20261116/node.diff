+});
+
+test("нет денег на счете - честный отказ, ничего не отправлено", async () => {
+  const { w, call } = setup({ chargeReply: () => ({ ok: false, reason: "insufficient_balance" }) });
+  const r = await call("POST", url, trx(w));
