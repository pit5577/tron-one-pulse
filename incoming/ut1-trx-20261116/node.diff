+// УТ-1 (Иван 16.11, вариант 1): перевод TRX с адреса, которому узел показывает обещанные ресурсы, идет через узел.
+// Полосы нет - нога bandwidth из Банка ({legs:"bandwidth", transfer:"trx"}), ждем ее в сети, отправляем; 0,32 спишет сервер
+// после перевода. Сеть отклонила - удержание снимаем сразу (П3). Получатель не активирован - отказ до зарядки (1 TRX сгорел бы).
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import type { CatFee, ChargeReply, UpstreamReply } from "../src/node.ts";
+import { buildTransfer, buildTrxTransfer, keyOf, addrOf, makeWorld, nodeFor, userOf, tokenFor, msg, type World } from "./helpers.ts";
+
+const IVAN = keyOf(1), ivan = addrOf(IVAN), bank = addrOf(keyOf(2));
+const url = `/n/${tokenFor("ivan")}/wallet/broadcasttransaction`;
+const trx = (w: { t: number }, to = bank) => buildTrxTransfer({ key: IVAN, to, amount: 130_000_000n, expiration: w.t + 55_000 });
+const LEG: ChargeReply = { ok: true, id: "t1", legs: "bandwidth", transfer: "trx", view: { id: "t1", status: "ready", ready: true, only: "bandwidth" } };
+
+function setup(over: Partial<World> = {}, o: { on?: boolean; vres?: boolean } = {}) {
+  const w = makeWorld({ bw: 0, energy: 0, chargeReply: () => LEG, onReady: (x) => { x.bw = 351; }, ...over });
+  const catfee: CatFee = { enabled: () => true, maxPerDay: 15, waitMs: 8_000, broadcast: async () => ({ status: 200, body: JSON.stringify({ result: true }) }) };
+  const call = nodeFor(w, [userOf("ivan", [ivan], { catfee: true })], {
+    catfee, catfeeNoFallback: true, energyBill: true, virtualResources: () => o.vres ?? true, trxTransfer: () => o.on ?? true, acceptEarly: false,
+  });
+  return { w, call };
+}
+const tick = () => new Promise((r) => setImmediate(r));
+
+test("П1: полосы нет - нога из Банка с transfer:trx, полоса в сети, перевод ушел; оценки контракта нет, энергия не заказана", async () => {
+  const { w, call } = setup();
+  const r = await call("POST", url, trx(w));
+  assert.equal(r.json.result, true, JSON.stringify(r.json));
+  assert.deepEqual(w.charges.map((c) => [c.legs, c.transfer]), [["bandwidth", "trx"]]);
+  assert.equal(w.broadcasts.length, 1);
+  assert.ok(!w.calls.some((c) => c.path === "/wallet/triggerconstantcontract"), "перевод TRX энергии не тратит");
+  const rec = w.journal.find((j) => j.decision)!;
+  assert.deepEqual([rec.asset, rec.reason, rec.charge], ["trx", "charged", "t1"]);
+  await tick();
+  assert.deepEqual(w.released, []);
+});
+
+test("своей полосы хватает - без зарядки, сразу в сеть (денег не берем)", async () => {
+  const { w, call } = setup({ bw: 400 });
+  const r = await call("POST", url, trx(w));
+  assert.equal(r.json.result, true);
+  assert.equal(w.charges.length, 0); assert.equal(w.broadcasts.length, 1);
+});
+
+test("получатель не активирован - отказ до зарядки: сеть сожгла бы 1 TRX молча", async () => {
+  const fresh = addrOf(keyOf(9));
+  const { w, call } = setup({ newAccounts: new Set([fresh]) });
+  const r = await call("POST", url, trx(w, fresh));
+  assert.equal(r.json.tronone, "trx_new_recipient");
+  assert.match(msg(r.json), /не активирован/);
+  assert.equal(w.charges.length, 0); assert.equal(w.broadcasts.length, 0);
+});
+
+test("П3: сеть отклонила перевод TRX (код) - удержание снимается сразу (low_resources), кошельку ответ сети", async () => {
+  const { w, call } = setup({ broadcastReply: (): UpstreamReply => ({ status: 200, body: JSON.stringify({ code: "CONTRACT_VALIDATE_ERROR", txid: "x", message: "62616c616e6365" }) }) });
+  const r = await call("POST", url, trx(w));
+  assert.equal(r.json.code, "CONTRACT_VALIDATE_ERROR");
+  await tick(); await tick();
+  assert.deepEqual(w.released, [{ id: "t1", reason: "low_resources" }]);
+  assert.ok(w.logs.some((l) => l.includes("сеть отклонила перевод TRX")));
+});
+
+test("неясный ответ сети (5xx) - удержание не трогаем: перевод мог уйти", async () => {
+  const { w, call } = setup({ broadcastReply: (): UpstreamReply => ({ status: 502, body: "{}" }) });
+  await call("POST", url, trx(w));
+  await tick();
+  assert.deepEqual(w.released, []);
+});
+
+test("полоса не легла до срока - отказ «полосы нет», TRX и баланс не списаны, удержание снято", async () => {
+  const { w, call } = setup({ chargeReply: () => ({ ...LEG, view: { id: "t1", status: "delivering", ready: false } }), onReady: () => {}, views: [{ id: "t1", status: "delivering", ready: false }] });
+  const r = await call("POST", url, trx(w));
+  assert.equal(r.json.tronone, "trx_no_bandwidth");
+  assert.match(msg(r.json), /полосы для перевода TRX сейчас нет/);
+  assert.equal(w.broadcasts.length, 0);
+  await tick(); await tick();
+  assert.deepEqual(w.released, [{ id: "t1", reason: "low_resources" }]);
+});
+
+test("сервер не понял transfer:trx (старый сервер) - перевод не отправлен, удержание снято, ALARM", async () => {
+  const { w, call } = setup({ chargeReply: () => ({ ok: true, id: "t1", legs: "bandwidth", view: { id: "t1", status: "ready", ready: true } }) });
+  const r = await call("POST", url, trx(w));
+  assert.equal(r.json.tronone, "unavailable");
+  assert.equal(w.broadcasts.length, 0);
+  await tick(); await tick();
