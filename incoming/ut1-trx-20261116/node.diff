+/** УТ-1: подписанный перевод TRX (TransferContract: owner=1, to=2, amount=3). */
+export function buildTrxTransfer(o: { key: Uint8Array; to: string; amount: bigint; expiration: number }) {
+  const owner = decodeBase58check(addrOf(o.key)), to = decodeBase58check(o.to);
+  const value = [...fBytes(1, owner), ...fBytes(2, to), ...fInt(3, o.amount)];
+  const any = [...fBytes(1, new TextEncoder().encode("type.googleapis.com/protocol.TransferContract")), ...fBytes(2, value)];
+  const c = [...fInt(1, 1), ...fBytes(2, any)];
+  const raw = Uint8Array.from([...fBytes(1, [0xab, 0xcd]), ...fBytes(4, new Uint8Array(8).fill(1)), ...fInt(8, o.expiration), ...fBytes(11, c), ...fInt(14, o.expiration - 60_000)]);
+  const txID = bytesToHex(sha256(raw));
+  const sig = secp.sign(hexToBytes(txID), o.key, { prehash: false, format: "recovered" });
+  const signature = bytesToHex(sig.slice(1)) + (sig[0]! + 0).toString(16).padStart(2, "0");
+  return { txID, raw_data_hex: bytesToHex(raw), signature: [signature], raw_data: { expiration: o.expiration, contract: [{ type: "TransferContract" }] }, visible: false };
+}
