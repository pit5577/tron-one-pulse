+
+test("другой токен (не USDT, не TRX) - по-прежнему only_usdt при подмене", async () => {
+  const { w, call } = setup();
+  const r = await call("POST", url, buildTransfer({ key: IVAN, to: bank, amount: 1n, expiration: w.t + 55_000, contract: bank }));
+  assert.equal(r.json.tronone, "only_usdt"); assert.equal(w.broadcasts.length, 0);
+});
+
+test("перевод TRX не подписан владельцем - отказ bad_signature без зарядки", async () => {
+  const { w, call } = setup();
+  const t = trx(w);
+  const forged = { ...t, signature: [buildTrxTransfer({ key: keyOf(5), to: bank, amount: 1n, expiration: w.t + 55_000 }).signature[0]!] };
+  const r = await call("POST", url, forged);
+  assert.equal(r.json.tronone, "bad_signature"); assert.equal(w.charges.length, 0);
