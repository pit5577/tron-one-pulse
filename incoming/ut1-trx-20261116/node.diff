+});
+
+test("выключатель off - прежний отказ only_usdt; без подмены ресурсов - перевод TRX как есть, без зарядки", async () => {
+  const off = setup({}, { on: false });
+  const r = await off.call("POST", url, trx(off.w));
+  assert.equal(r.json.tronone, "only_usdt"); assert.equal(off.w.broadcasts.length, 0);
